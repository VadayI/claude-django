{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(docker compose:*)",
      "Bash(npm:*)",
      "Bash(npx:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(.claude/settings.local.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.kdbx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials*)",
      "Read(secrets/**)",
      "Read(**/*.sqlite3)"
    ]
  },
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings.dev",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/policy/block_protected_edits.py",
            "statusMessage": "Checking protected-file edit policy..."
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/policy/log_command.py",
            "statusMessage": "Logging command..."
          }
        ]
      },
      {
        "matcher": "create-pr",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/policy/check_command_gate.py",
            "statusMessage": "Checking command preconditions..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "ba|api-architect|django-developer|tester|docs-writer",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/policy/check_plan_execution_log.py",
            "statusMessage": "Checking living-plan execution log..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/policy/auto_format.py format",
            "statusMessage": "Formatting Python (ruff format)..."
          },
          {
            "type": "command",
            "command": "python scripts/policy/auto_format.py check",
            "statusMessage": "Auto-fixing lint (ruff --fix)..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/session-start.py",
            "statusMessage": "Detecting environment..."
          }
        ]
      }
    ]
  },
  "_last_reviewed": "2026-06-01"
}
