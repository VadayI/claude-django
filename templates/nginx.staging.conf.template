# nginx reverse-proxy template for the staging backend (gunicorn in Docker).
#
# This is a TEMPLATE: render the ${...} placeholders before use, e.g.
#   export STAGING_HOST=app.staging.example.com
#   export BACKEND_UPSTREAM=127.0.0.1:8000   # where this VPS reaches gunicorn
#   envsubst '${STAGING_HOST} ${BACKEND_UPSTREAM}' \
#     < nginx.staging.conf.template > /etc/nginx/sites-available/${STAGING_HOST}
#   ln -s /etc/nginx/sites-available/${STAGING_HOST} /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Notes:
#   * The VPS already runs many projects — give each its own server_name
#     (subdomain) and its own upstream port so they do not collide.
#   * docker-compose.staging.yml `expose`s gunicorn on the compose network. To
#     let the host nginx reach it, either publish backend :8000 to 127.0.0.1 on
#     the host, or run nginx itself in the same compose network. Set
#     ${BACKEND_UPSTREAM} accordingly (e.g. 127.0.0.1:8000 or backend:8000).
#   * TLS is omitted here; terminate it with certbot / your proxy of choice and
#     add the usual `listen 443 ssl;` + certificate lines, redirecting 80 -> 443.

upstream ${STAGING_HOST}_backend {
    server ${BACKEND_UPSTREAM};
}

server {
    listen 80;
    server_name ${STAGING_HOST};

    # Health probe is cheap and unauthenticated — let it through directly.
    location = /api/v1/health/ {
        proxy_pass http://${STAGING_HOST}_backend;
        access_log off;
    }

    location / {
        proxy_pass http://${STAGING_HOST}_backend;

        # Forwarded headers gunicorn + Django (SECURE_PROXY_SSL_HEADER) trust.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_redirect off;
        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
        client_max_body_size  25m;
    }

    # If you serve collected static files from the host instead of WhiteNoise,
    # point this at STATIC_ROOT and uncomment:
    # location /static/ {
    #     alias /srv/${STAGING_HOST}/static/;
    #     expires 7d;
    # }
}
