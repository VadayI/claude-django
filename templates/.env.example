# Copy this file to `.env` at the project root and fill in real values.
# `.env` is gitignored — never commit it. The example is committed so a new
# clone knows which keys to expect.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- PostgreSQL (consumed by docker-compose.yml) ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgres://app:app@db:5432/app

# --- API contract (claude-api-contract — single source of truth, ADR 0017) ---
# The canonical openapi.yml is authored externally and CONSUMED here. Pin the tag;
# raising it is a deliberate PR, never an auto-drift. Pull: scripts/pull_contract.sh.
CONTRACT_REPO=VadayI/claude-api-contract
CONTRACT_VERSION=v0.2.0
# Optional online contract source. When set, scripts/pull_contract.sh fetches the
# OpenAPI contract from this full URL instead of GitHub raw — so the backend build
# can reach the contract online (any host that serves the raw openapi.yml file). Leave empty
# to use the pinned CONTRACT_REPO@CONTRACT_VERSION (GitHub raw) default.
# Fetch-only: the drift check (pull_contract.sh --check) always validates against
# the pinned tag (ADR 0025).
# Example: CONTRACT_URL=https://contracts.example.com/openapi.yml
CONTRACT_URL=

# --- MCP servers + gh CLI (sourced by scripts/claude.sh / make cc) ---
# GitHub MCP + gh CLI — PR data, reviews, branch protection.
# Fine-grained PAT (github_pat_...) recommended (ADR 0008). Required repo permissions:
# Contents RW, Pull requests RW, Workflows RW, Administration RW, Metadata RO.
# The wrapper copies this into GH_TOKEN and drops any stale GITHUB_TOKEN (ADR 0023).
GITHUB_PERSONAL_ACCESS_TOKEN=
# Context7 MCP — up-to-date library docs (Django, DRF, PostgreSQL). Get a key at
# https://context7.com/
CONTEXT7_API_KEY=

# --- Staging (VPS deploy via the `devops` agent) ---
# Used by docker-compose.staging.yml; leave blank for local-only work.
STAGING_HOST=
STAGING_USER=
STAGING_SSH_KEY_PATH=
# Host port for the staging Postgres (non-default to avoid clashing with other
# projects on the shared VPS). The container still listens on 5432 internally.
STAGING_DB_PORT=5433
# Names the staging Docker network/project so multiple stacks coexist on the VPS.
COMPOSE_PROJECT_NAME=
# On staging, DJANGO_ALLOWED_HOSTS must be your staging subdomain (e.g.
# app.staging.example.com) and DJANGO_SECRET_KEY/POSTGRES_PASSWORD must be real
# secrets — docker-compose.staging.yml fails fast if they are unset.

# Last reviewed/updated: 2026-07-07 (v0.2.0 pin; ADR 0008 permissions wording; ADR 0023 wrapper flow)
