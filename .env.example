# .env for the claude-django project (gitignored — never commit; copy to .env).
# Sourced by scripts/claude.sh / scripts/claude.ps1 when you launch Claude Code,
# so every variable below — and especially the MCP/gh credentials — reaches the
# MCP servers, the gh CLI and the tooling WITHOUT exporting anything in your
# shell rc. Fill real values:  cp .env.example .env  &&  edit .env

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- PostgreSQL ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgres://app:app@db:5432/app

# --- API contract (pinned external claude-api-contract) ---
CONTRACT_REPO=VadayI/claude-api-contract
CONTRACT_VERSION=v0.4.0

# --- MCP servers + gh CLI (sourced by scripts/claude.sh) ---
# GitHub MCP + gh CLI — PR data, reviews, branch protection.
# Fine-grained PAT (github_pat_...) recommended. Required repo permissions:
# Contents RW, Pull requests RW, Workflows RW, Administration RW, Metadata RO.
# The wrapper copies this into GH_TOKEN and drops any stale GITHUB_TOKEN.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Context7 MCP — up-to-date Django / DRF / PostgreSQL docs.
CONTEXT7_API_KEY=

# --- Staging (VPS deploy) ---
STAGING_HOST=
STAGING_USER=
STAGING_SSH_KEY_PATH=
STAGING_DB_PORT=5433
COMPOSE_PROJECT_NAME=
